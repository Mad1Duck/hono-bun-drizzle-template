# Copy this file to .env.ha and adjust for HA docker-compose deployment

# =====================================================================
# Database
# =====================================================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/backend_djuanda

# =====================================================================
# Redis
# =====================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EVENT_BUS=true

# =====================================================================
# Logging
# =====================================================================
LOG_LEVEL=info
LOG_PRETTY=false

# Loki sink (optional, see packages/logger loki setup)
# LOKI_URL=http://loki:3100

# =====================================================================
# Auth
# =====================================================================
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# =====================================================================
# Services
# =====================================================================
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
RBAC_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
STORAGE_SERVICE_PORT=3005

# Gateway internal URLs (use service names because all are in docker network)
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
RBAC_SERVICE_URL=http://rbac-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3004
STORAGE_SERVICE_URL=http://storage-service:3005
