# =====================================================================
# Database (packages/database) -- dipakai auth-service, notification-service,
# user-service. Gateway TIDAK butuh ini.
# =====================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/backend_djuanda

# =====================================================================
# Redis (packages/config) -- dipakai rate limiter (@repo/shared) & bullmq
# email queue (auth-service) dan event bus (packages/shared).
# =====================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# Set ke 'true' untuk mengaktifkan Redis Pub/Sub sebagai distributed event bus.
# Default true karena Redis sudah menjadi bagian dari stack.
REDIS_EVENT_BUS=true

# =====================================================================
# Logging (packages/logger)
# =====================================================================
LOG_LEVEL=info
# Set LOG_PRETTY=true untuk pretty print di lokal; default false saat NODE_ENV=production.
# Untuk sink terpusat (Loki/CloudWatch/OpenTelemetry), tambahkan transport module di runtime.
LOG_PRETTY=true

# =====================================================================
# Auth (auth-service) -- JWT_SECRET harus SAMA dengan punya gateway,
# karena gateway ikut memverifikasi token yang diterbitkan auth-service.
# =====================================================================
AUTH_SERVICE_PORT=3001
JWT_SECRET=change-me-to-a-long-random-secret

# Rate limit percobaan login (per username), dipakai auth-service
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# JWT TTL (detik untuk access, hari untuk refresh). Access token pendek agar role change cepat reflect via refresh.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Upload file (storage module di auth-service)
UPLOADTHING_SECRET=

# Email (email module di auth-service, belum ada trigger pemanggil)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# =====================================================================
# Storage service
# =====================================================================
STORAGE_SERVICE_PORT=3003
UPLOADTHING_SECRET=

# =====================================================================
# RBAC service
# =====================================================================
RBAC_SERVICE_PORT=3005

# =====================================================================
# Notification service
# =====================================================================
NOTIFICATION_SERVICE_PORT=3004

# =====================================================================
# User service
# =====================================================================
USER_SERVICE_PORT=3002

# Service discovery convention:
# - Untuk local dev: http://localhost:<PORT>
# - Untuk docker / kubernetes: http://<service-name>:<PORT>
# Contoh: AUTH_SERVICE_URL=http://auth-service:3001

# =====================================================================
# Gateway -- satu-satunya service yang boleh diakses langsung dari luar
# =====================================================================
PORT=8080
CORS_ORIGIN=localhost

# Rate limit per-IP di edge (beda dari LOGIN_RATE_LIMIT_* di atas yang per-username)
RATE_LIMIT_MAX_ATTEMPTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Gateway HTTP proxy resilience
PROXY_TIMEOUT_MS=5000
PROXY_RETRIES=2
PROXY_RETRY_DELAY_MS=500
PROXY_CIRCUIT_BREAKER_THRESHOLD=5
PROXY_CIRCUIT_BREAKER_RESET_MS=30000

# URL internal tiap service (dipakai gateway untuk proxy + health check /ready)
# Untuk docker-compose atau kubernetes, ganti dengan http://<service-name>:<port>.
# Contoh: AUTH_SERVICE_URL=http://auth-service:3001
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3004
USER_SERVICE_URL=http://localhost:3002
STORAGE_SERVICE_URL=http://localhost:3003
RBAC_SERVICE_URL=http://localhost:3005

# Opsional: suffix untuk DNS internal service discovery.
# Kalau di-set, gateway bisa resolve ke http://<service-name><SUFFIX>:<port>
# SERVICE_DISCOVERY_SUFFIX=-svc
